#!/bin/bash
# /usr/local/lib/aos/run-as-agent (root:root 0755). The ONE command the plane user may run as
# aos-agent (sudoers.d/aos). docs/agentic-os-auto-copilot-plan.md §C.0, P0-A2.
#
#   run-as-agent run <id> <max-seconds> <cwd> -- <cmd> [args...]
#   run-as-agent stop <id>
#
# `run` starts <cmd> in a transient scope `aos-run-<id>` of aos-agent's user manager, killed
# after <max-seconds> whatever the plane does. `stop` stops that scope. Every argument is
# validated here: the caller is not trusted, and sudo's env_reset has already dropped its
# environment.
set -euo pipefail
# Group-writable: the plane user is a member of aos and must be able to read, commit and remove
# what the agent writes in a worktree. aos-agent's own home is 0700, so nothing else widens.
umask 007
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
export PATH=/usr/local/bin:/usr/bin:/bin
WORKTREES=/var/lib/aos/worktrees
mode="${1:-}"; id="${2:-}"
[[ "$id" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || { echo "run-as-agent: bad id" >&2; exit 64; }
unit="aos-run-$id"
case "$mode" in
  stop)
    [ "$#" -eq 2 ] || exit 64
    # A unit that already ended is not an error for the caller.
    systemctl --user stop "$unit.scope" 2>/dev/null || true ;;
  run)
    secs="${3:-}"; cwd="${4:-}"; [ "${5:-}" = "--" ] || exit 64
    [[ "$secs" =~ ^[0-9]{1,5}$ ]] && [ "$secs" -ge 1 ] && [ "$secs" -le 14400 ] || { echo "run-as-agent: bad seconds" >&2; exit 64; }
    # Resolve first: a pattern match on the raw string would accept /var/lib/aos/worktrees/../..
    real="$(realpath -e -- "$cwd" 2>/dev/null)" || { echo "run-as-agent: cwd does not exist" >&2; exit 64; }
    case "$real" in "$WORKTREES"|"$WORKTREES"/*) ;; *) echo "run-as-agent: cwd outside $WORKTREES" >&2; exit 64;; esac
    [ -d "$real" ] || exit 64
    shift 5
    [ "$#" -ge 1 ] || exit 64
    exec systemd-run --user --scope --quiet --collect --unit="$unit" \
      -p RuntimeMaxSec="$secs" -p TimeoutStopSec=5 -p MemoryMax=1500M -p TasksMax=256 \
      --working-directory="$real" -- "$@" ;;
  *) exit 64 ;;
esac
