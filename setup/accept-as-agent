#!/bin/bash
# /usr/local/lib/aos/accept-as-agent (root:root 0755). P0-4, docs/agentic-os-auto-copilot-plan.md
# §C.2.7 step 4: an acceptance command runs as aos-agent with NO network.
#
#   accept-as-agent run <id> <max-seconds> <cwd> -- <cmd> [args...]
#   accept-as-agent stop <id>
#
# The plane runs this as root (sudoers.d/aos, this file only, env_reset). Root makes the network
# namespace, because Ubuntu's kernel.apparmor_restrict_unprivileged_userns=1 refuses the
# unprivileged `unshare --user --net` that aos-agent could do on its own. In that namespace only
# `lo` exists and it is brought up, so tests that serve on 127.0.0.1 keep working, nothing routes
# out, and the host's loopback services (plane API, Cockpit) are not there. Root then drops to
# aos-agent:aos for good (setpriv: real+effective ids, no capabilities, no_new_privs) before
# <cmd> starts, so plane-owned files of the read-only snapshot stay read-only exactly as in `run`.
#
# <cmd> runs in a transient system scope `aos-accept-<id>`, killed after <max-seconds> whatever the
# plane does; the plane already sets that bound at or before the window close (§C.2.5). `stop`
# stops that scope. Every argument is validated here: the caller is not trusted, and sudo's
# env_reset has already dropped its environment. No sysctl or AppArmor setting is changed.
set -euo pipefail
umask 007
export PATH=/usr/local/bin:/usr/bin:/bin
AGENT=aos-agent
GROUP=aos
WORKTREES=/var/lib/aos/worktrees
[ "$(id -u)" = 0 ] || { echo "accept-as-agent: must run as root" >&2; exit 64; }
mode="${1:-}"; id="${2:-}"
[[ "$id" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || { echo "accept-as-agent: bad id" >&2; exit 64; }
unit="aos-accept-$id"
case "$mode" in
  stop)
    [ "$#" -eq 2 ] || exit 64
    # A unit that already ended is not an error for the caller.
    systemctl stop "$unit.scope" 2>/dev/null || true ;;
  run)
    secs="${3:-}"; cwd="${4:-}"; [ "${5:-}" = "--" ] || exit 64
    [[ "$secs" =~ ^[0-9]{1,5}$ ]] && [ "$secs" -ge 1 ] && [ "$secs" -le 14400 ] || { echo "accept-as-agent: bad seconds" >&2; exit 64; }
    # Resolve first: a pattern match on the raw string would accept /var/lib/aos/worktrees/../..
    real="$(realpath -e -- "$cwd" 2>/dev/null)" || { echo "accept-as-agent: cwd does not exist" >&2; exit 64; }
    case "$real" in "$WORKTREES"/?*) ;; *) echo "accept-as-agent: cwd outside $WORKTREES" >&2; exit 64;; esac
    [ -d "$real" ] || exit 64
    home="$(getent passwd "$AGENT" | cut -d: -f6)"
    [ -n "$home" ] || { echo "accept-as-agent: no user $AGENT" >&2; exit 64; }
    shift 5
    [ "$#" -ge 1 ] || exit 64
    # systemd-run, unshare, sh and setpriv each exec the next: one process, so sudo's signal relay
    # and the scope's stop both reach <cmd>.
    exec systemd-run --scope --quiet --collect --unit="$unit" \
      -p RuntimeMaxSec="$secs" -p TimeoutStopSec=5 -p MemoryMax=1500M -p TasksMax=256 \
      --working-directory="$real" -- \
      /usr/bin/unshare --net -- \
      /bin/sh -c '/usr/sbin/ip link set lo up || exit 70; exec "$@"' aos-accept \
      /usr/bin/setpriv --reuid="$AGENT" --regid="$GROUP" --init-groups --no-new-privs --inh-caps=-all --bounding-set=-all -- \
      /usr/bin/env -i HOME="$home" PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 "$@" ;;
  *) exit 64 ;;
esac
