  },
  "dependencies": {
    "@agent-plane/adapters": "workspace:*",
    "@agent-plane/core": "workspace:*",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  }
}
