{
  "name": "@agent-plane/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "open": "tsx src/bin/open-web.ts",
    "rotate": "tsx src/bin/rotate-credential.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:harness-on": "vitest run",
