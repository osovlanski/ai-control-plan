{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plane.local/contracts/mcp-tools/v1/get_task.output.schema.json",
  "title": "GetTaskOutput",
  "description": "get_task structuredContent: a read-only projection of plane reads. Approvals are answered on the Web link, never here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "goal",
    "state",
    "stage",
    "repo",
    "webLink",
    "createdAt",
    "updatedAt",
    "pendingApprovals",
    "latestRun",
    "verification"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^AG-[0-9a-z]{1,32}$",
      "description": "Plane task id (`newTaskId`, packages/core/src/ids.ts)."
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "state": {
      "enum": [
        "CREATED",
        "ROUTING",
        "RUNNING",
        "WAITING_RESOURCE",
        "WAITING_INPUT",
        "LIMIT_PAUSED",
        "HANDING_OFF",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "description": "Task state (TASK_STATES, packages/core/src/state-machine.ts)."
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "rule"
      ],
      "description": "The plane's task stage, copied from GET /api/tasks. Values and rules are those of contracts/task-stage/v1; the MCP service never derives a stage.",
      "properties": {
        "value": {
          "enum": [
            "done",
            "needs-you",
            "verifying",
            "working",
            "queued"
          ]
        },
        "rule": {
          "enum": [
            "terminal",
            "waiting-input",
            "limit-paused",
            "awaiting-approval",
            "verification-running",
            "run-ended-unsettled",
            "live-run",
            "run-starting",
            "wait-condition",
            "no-run"
          ]
        }
      }
    },
    "repo": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "A repository alias from the MCP service's exposed-repo map. Never a filesystem path."
    },
    "webLink": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/#/missions/AG-[0-9a-z]{1,32}$",
      "description": "Private Web link to the task: the configured HTTPS Web origin + `/#/missions/<taskId>`. Reachable only on the private network."
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "pendingApprovals": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of pending approvals. Only a count: the approval itself is Web-only."
    },
    "latestRun": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "runId",
        "assistantId",
        "state",
        "startedAt",
        "endedAt"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assistantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The run's effective state as GET /api/tasks/:id serves it."
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        }
      }
    },
    "verification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "runState",
        "checks"
      ],
      "description": "The latest verification run of the latest Harness session, as the plane stores it; null when none exists.",
      "properties": {
        "runState": {
          "enum": [
            "ready",
            "claimed",
            "completed",
            "interrupted"
          ]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "failed",
            "skipped",
            "blocked"
          ],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            },
            "blocked": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
