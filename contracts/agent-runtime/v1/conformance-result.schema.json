{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plane.local/contracts/agent-runtime/v1/conformance-result.schema.json",
  "title": "ConformanceResult",
  "description": "Agent runtime v1.1: the response of POST /api/assistants/:id/test, the credential-free, quota-free runtime conformance probe. Only classified outcomes: check names, statuses, evidence levels, fixed reasons and timestamps; never stdout, stderr, a provider transcript or a credential. Normative text: docs/contracts/agent-runtime-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assistantId",
    "provider",
    "descriptorVersion",
    "status",
    "reasons",
    "recorded",
    "checkedAt",
    "checks",
    "lifecycle"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "assistantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "descriptorVersion": {
      "type": "integer",
      "minimum": 1
    },
    "cliVersion": {
      "allOf": [
        {
          "$ref": "#/$defs/noInlineSecret"
        }
      ],
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "The version this test observed: `in-process` for an in-process runtime, `unavailable` when the CLI did not run. Absent when unsafe to repeat."
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unsupported"
      ],
      "description": "`pass`: no check failed or was unavailable, no claim is unproven, and at least one check passed. `unsupported`: nothing could be checked (not recorded)."
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "recorded": {
      "type": "boolean",
      "description": "A runtime_conformance row was written for (assistant, cliVersion, descriptorVersion)."
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "level",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}(:[a-z][a-z0-9-]{0,47})?$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unsupported",
              "unavailable",
              "not-run"
            ]
          },
          "level": {
            "enum": [
              "build",
              "host",
              "provider"
            ],
            "description": "build: this build's adapter code; host: this machine; provider: the provider CLI's own behaviour."
          },
          "reason": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "lifecycle": {
      "$ref": "assistant-lifecycle.schema.json"
    }
  },
  "if": {
    "type": "object",
    "properties": {
      "status": {
        "const": "fail"
      }
    }
  },
  "then": {
    "type": "object",
    "properties": {
      "reasons": {
        "type": "array",
        "minItems": 1
      }
    }
  },
  "else": {
    "type": "object",
    "properties": {
      "reasons": {
        "type": "array",
        "maxItems": 0
      }
    }
  },
  "$defs": {
    "reason": {
      "enum": [
        "version_reported",
        "executable_missing",
        "executable_not_runnable",
        "nonzero_exit",
        "empty_version",
        "unsafe_version_output",
        "timeout",
        "in_process_runtime",
        "refused_before_launch",
        "refused_for_other_reason",
        "not_refused",
        "launch_attempted",
        "no_tripwire",
        "all_modes_enforced",
        "claims_backed",
        "unproven_claim",
        "no_manifest",
        "no_host_claim",
        "host_probe_not_authorized",
        "no_secret_in_manifest",
        "secret_in_manifest",
        "quota_free_unverified",
        "no_self_description",
        "scripted_run_completed",
        "scripted_run_incomplete",
        "not_in_process"
      ]
    },
    "noInlineSecret": {
      "description": "Rejects a recognised inline credential (Bearer token, key=/token=/secret=/password= value, quoted or not, with optional spaces around =) unless it is a ${VAR} placeholder or the redaction marker ***.",
      "type": "string",
      "maxLength": 4096,
      "not": {
        "pattern": "\\b(?:[Bb][Ee][Aa][Rr][Ee][Rr]\\s+|(?:[Aa][Pp][Ii]_?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Cc][Cc][Ee][Ss][Ss]_[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Kk][Ee][Yy])\\s*=\\s*[\"']?)(?!\\$\\{|\\*\\*\\*)[^\\s&\"']"
      }
    }
  }
}
