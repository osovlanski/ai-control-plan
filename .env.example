# Example environment for local development. Copy to .env and replace placeholders.
# Nothing in this repo loads .env automatically; export these in your shell or
# set them in your environment's settings. Never commit a real key.

# OpenAI / Codex adapter credential (packages/adapters/src/codex.ts, eval/run.ts).
# Any non-empty value makes the Codex adapter report auth as configured, so leave
# this unset rather than exporting the placeholder.
OPENAI_API_KEY=FAKE-openai-not-real
